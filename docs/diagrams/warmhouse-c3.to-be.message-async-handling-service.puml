Rel(HandleUserModulesScriptsCommandConsumer, ProducePushHandlingResultsCommandHandler,"Использует")
Rel(HandleUserModulesScriptsCommandConsumer, HandleUserModulesScriptsCommandHandler,"Использует")
Rel(HandleUserModulesScriptsCommandHandler, ModulesControlServiceApiClientsProvider,"Использует")

Rel(HandleModuleControlCommandConsumer, MessagesConsumer,"Использует")
Rel(HandleModuleControlCommandConsumer, ProducePushHandlingResultsCommandHandler,"Использует")
Rel(HandleModuleControlCommandConsumer, HandleModuleControlCommandHandler,"Использует")
Rel(HandleModuleControlCommandHandler, ModulesControlServiceApiClientsProvider,"Использует")

Rel(CreateControlModuleCommandConsumer, MessagesConsumer,"Использует")
Rel(CreateControlModuleCommandConsumer, ProducePushHandlingResultsCommandHandler,"Использует")
Rel(CreateControlModuleCommandConsumer, CreateControlModuleCommandHandler,"Использует")
Rel(CreateControlModuleCommandHandler, ModulesControlServiceApiClientsProvider,"Использует")

Rel(DeleteControlModuleCommandConsumer, MessagesConsumer,"Использует")
Rel(DeleteControlModuleCommandConsumer, ProducePushHandlingResultsCommandHandler,"Использует")
Rel(DeleteControlModuleCommandConsumer, DeleteControlModuleCommandHandler,"Использует")
Rel(DeleteControlModuleCommandHandler, ModulesControlServiceApiClientsProvider,"Использует")

Rel(UpdateUserModuleStatusCommandConsumer, MessagesConsumer,"Использует")
Rel(UpdateUserModuleStatusCommandConsumer, ProducePushHandlingResultsCommandHandler,"Использует")
Rel(UpdateUserModuleStatusCommandConsumer, UpdateUserModuleStatusCommandHandler,"Использует")
Rel(UpdateUserModuleStatusCommandHandler, ModulesControlServiceApiClient,"Использует")

Rel(PushHandlingResultsCommandConsumer, MessagesConsumer,"Использует")
Rel(PushHandlingResultsCommandConsumer, ProducePushHandlingResultsCommandHandler,"Использует")
Rel(PushHandlingResultsCommandConsumer, PushHandlingResultsCommandHandler,"Использует")
Rel(PushHandlingResultsCommandHandler, HandlingResultsPushServiceApiClient,"Использует")

Rel(ProducePushHandlingResultsCommandHandler, MessagesProducer,"Использует")

Rel(MessagesProducer, MessageBroker,"Публикует сообщения в", "AMQP")
Rel(MessageBroker, MessagesConsumer,"Отправляет сообщения в", "AMQP")

@enduml